{
  "name": "ds-harness-remote",
  "version": "0.4.11",
  "description": "End-to-end encrypted remote access to DeepSeek Harness and experimental Codex workspaces from desktop, web, and Android, with dsh-TUI Host support.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "codex",
    "remote-development",
    "end-to-end-encryption",
    "webrtc"
  ],
  "homepage": "https://github.com/liguobao/ds-harness-remote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liguobao/ds-harness-remote.git"
  },
  "bugs": {
    "url": "https://github.com/liguobao/ds-harness-remote/issues"
  },
  "author": "liguobao <lgb835485368@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "ds-harness-remote": "./bin/ds-harness-remote.js"
  },
  "types": "./public.d.ts",
  "exports": {
    ".": {
      "types": "./public.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "public.d.ts",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/verify-version-sync.mjs && tsc -p tsconfig.json && node scripts/build-bundles.mjs",
    "check": "node scripts/verify-version-sync.mjs && tsc -p tsconfig.test.json",
    "test": "node scripts/verify-version-sync.mjs && vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "qrcode": "^1.5.4",
    "werift": "0.24.4",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@roamhq/wrtc": "0.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-alpha.1 <=0.1.2-rc.1 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-alpha.1 <=0.1.2-rc.1 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-alpha.1 <=0.1.2-rc.1 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-alpha.1 <=0.1.2-rc.1 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-alpha.1 <=0.1.2-rc.1 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-alpha.1 <=0.1.2-rc.1 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-alpha.1 <=0.1.2-rc.1 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-alpha.1 <=0.1.2-rc.1 || 0.1.5-alpha.1",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-plugins": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-api-gateway": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-brand": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-scope": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.5-alpha.1",
    "@dsh-remote/client-core": "workspace:*",
    "@dsh-remote/crypto": "workspace:*",
    "@dsh-remote/protocol": "workspace:*",
    "@dsh-remote/webrtc": "workspace:*",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
