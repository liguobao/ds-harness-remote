    "vitest": "^2.1.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "antd": "^5.22.7",
    "@ant-design/icons": "^5.6.1"
  },
  "files": [
    "dist"
