# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native signing material. Never commit these: this repository is public.
*.p8
*.p12
*.key
*.mobileprovision
*.cer
*.certSigningRequest

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native project
# `expo prebuild --platform ios` regenerates all of ios/ from app.json,
# app.config.js and plugins/, so the native project is a build artifact here.
/ios

# build artifacts
*.ipa
*.xcarchive
