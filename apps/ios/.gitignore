# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native signing material. Never commit these: this repository is public.
*.p8
*.p12
*.key
*.mobileprovision
*.cer
*.certSigningRequest

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Native project: committed because Xcode Cloud builds the workspace straight
# from the repository (see docs/ios-xcode-cloud.md). Pods/, build/ and
# .xcode.env.local stay ignored via the committed ios/.gitignore template.
# Never commit signing material under any circumstances.
*.ipa
*.xcarchive
