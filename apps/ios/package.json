{
  "name": "@dsh-remote/ios",
  "version": "0.6.8",
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "@dsh-remote/app-core": "workspace:*",
    "@dsh-remote/client-core": "workspace:*",
    "@dsh-remote/crypto": "workspace:*",
    "@dsh-remote/protocol": "workspace:*",
    "@dsh-remote/webrtc": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "expo": "~57.0.13",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.11",
    "expo-clipboard": "~57.0.1",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.10",
    "expo-localization": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "lucide-react-native": "^1.31.0",
    "markdown-it": "^14.3.3",
    "mathjax-full": "3.2.2",
    "mermaid": "12.2.0",
    "pdfjs-dist": "6.3.289",
    "qrcode-generator": "2.0.4",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webrtc": "^124.0.8",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.7",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prepare:workspace": "pnpm --filter '@dsh-remote/ios^...' -r build && pnpm run build:renderers && pnpm run verify:workspace",
    "build:renderers": "pnpm --filter @dsh-remote/app-core run build:renderers",
    "verify:workspace": "node ../../packages/app-core/scripts/verify-workspace-data-planes.mjs \"$PWD\"",
    "prestart": "pnpm run prepare:workspace",
    "start": "expo start",
    "preios": "pnpm run prepare:workspace",
    "ios": "expo run:ios",
    "check": "pnpm run build:renderers && pnpm run verify:workspace && tsc --noEmit",
    "prebuild": "pnpm run prepare:workspace",
    "generate:ios": "expo prebuild --platform ios --no-clean",
    "build": "expo export --platform ios"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ]
      }
    }
  }
}
