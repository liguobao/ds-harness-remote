{
  "name": "@dsh-remote/android",
  "version": "0.4.11",
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "@dsh-remote/client-core": "workspace:*",
    "@dsh-remote/crypto": "workspace:*",
    "@dsh-remote/protocol": "workspace:*",
    "@dsh-remote/webrtc": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.13",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.10",
    "expo-intent-launcher": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "lucide-react-native": "^1.31.0",
    "markdown-it": "^14.1.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webrtc": "^124.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.7",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "prepare:workspace": "pnpm --filter '@dsh-remote/android^...' -r build && pnpm run verify:workspace",
    "verify:workspace": "node scripts/verify-workspace-data-planes.mjs",
    "prestart": "pnpm run prepare:workspace",
    "start": "expo start",
    "preandroid": "pnpm run prepare:workspace",
    "android": "expo run:android",
    "preios": "pnpm run prepare:workspace",
    "ios": "expo run:ios",
    "check": "pnpm run verify:workspace && tsc --noEmit",
    "test": "pnpm run verify:workspace && vitest run",
    "prebuild": "pnpm run prepare:workspace",
    "build": "expo export --platform android"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ]
      }
    }
  }
}
