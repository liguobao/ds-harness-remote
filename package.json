{
  "name": "ds-harness-remote",
  "version": "0.6.8",
  "description": "P2P-based, end-to-end encrypted remote access to DeepSeek Harness, CodeX, Claude Code, Pi, and other workspaces from web and mobile clients.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "codex",
    "remote-development",
    "end-to-end-encryption",
    "webrtc"
  ],
  "homepage": "https://github.com/liguobao/ds-harness-remote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liguobao/ds-harness-remote.git"
  },
  "bugs": {
    "url": "https://github.com/liguobao/ds-harness-remote/issues"
  },
  "author": "liguobao <lgb835485368@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "bin": {
    "ds-harness-remote": "./packages/plugin/bin/ds-harness-remote.js"
  },
  "types": "./packages/plugin/public.d.ts",
  "exports": {
    ".": {
      "types": "./packages/plugin/public.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./client": "./packages/plugin/dist/client.github.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "packages/plugin/dist/index.js",
    "packages/plugin/dist/client.github.js",
    "packages/plugin/bin/ds-harness-remote.js",
    "packages/plugin/public.d.ts",
    "packages/plugin/LICENSE",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "locale/",
    "README.md",
    "package.json",
    "icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@0.8": "^0.8.15",
      "@xmldom/xmldom@0.9": "^0.9.12",
      "brace-expansion@5": "^5.0.12",
      "compression@1": "^1.8.2",
      "js-yaml@4": "^4.3.2",
      "shell-quote@1": "^1.11.0",
      "source-map-js@1": "^1.2.2"
    },
    "patchedDependencies": {
      "react-native@0.86.2": "patches/react-native@0.86.2.patch",
      "react-native-webview@13.16.1": "patches/react-native-webview@13.16.1.patch",
      "react-native-safe-area-context@5.7.0": "patches/react-native-safe-area-context@5.7.0.patch",
      "expo-localization@57.0.1": "patches/expo-localization@57.0.1.patch",
      "expo-modules-autolinking@57.0.10": "patches/expo-modules-autolinking@57.0.10.patch"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.20.0-alpha.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5 || >=4.0.5-alpha.1 <4.0.6-0 || 4.2.0-alpha.1",
    "@deepseek-ai/dsh-api-gateway": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0",
    "@deepseek-ai/dsh-client-file-upload": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0",
    "react": ">=18.2.0 <19",
    "@deepseek-ai/dsh-client-ui-settings-general": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-file-upload": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-general": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.2.0-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.2.0-alpha.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-api-remote-access": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-brand": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.3-alpha.2",
    "@types/node": "^24.9.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@types/ws": "^8.18.1",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.3-alpha.2"
  },
  "optionalDependencies": {
    "@roamhq/wrtc": "0.10.0"
  }
}
